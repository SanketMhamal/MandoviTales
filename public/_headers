# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Next.js build files have content hashes in their names, so they never change
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Photos, map and textures: cache for a month
/images/*
  Cache-Control: public, max-age=2592000
/textures/*
  Cache-Control: public, max-age=2592000
